APP_NAME=MedAssist API
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=info
# Websites on other addresses allowed to call the API. (In development, any localhost
# port is already allowed.) Example:
# APP_CORS_ORIGINS=["https://your-site.example"]

# Set when a proxy serves the site under a sub-path, e.g. the workshop editor's /app:
# APP_ROOT_PATH=/app

APP_DATABASE_URL=sqlite:///./app.db
# APP_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# `make install` fills this in for you. To generate one by hand:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
